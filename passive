-- Biến zombie thành hitbox (chỉ hiển thị, không ảnh hưởng game)
function TotallyBoxed(target)
    pcall(function()
        if target and target:FindFirstChild("HumanoidRootPart") then
            local hrp = target.HumanoidRootPart
            -- Chỉ thay đổi transparency để dễ nhìn hitbox hơn
