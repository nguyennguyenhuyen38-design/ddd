    end)

    deselBtn.MouseButton1Click:Connect(function()
        for _, item in ipairs(TradeItems) do
            item.selected = false
        end
        RenderList()
    end)

    tradeBtn.MouseButton1Click:Connect(function()
        if not TargetPlayer then
            LogErr("Chua chon player!")
            CreatePlayerSelector(function(p)
                TargetPlayer = p
                UpdateTarget()
            end)
            return
        end
        local selectedCount = 0
        for _, item in ipairs(TradeItems) do
            if item.selected then selectedCount = selectedCount + item.qty end
        end
        if selectedCount == 0 then
            LogErr("Chua chon item nao!")
            return
        end

        -- Gui trade
        SendTradeToPlayer(TargetPlayer)

        -- Add items
        task.spawn(function()
            task.wait(0.5)
            AddItemsInTradeGui()
            RefreshStats()
        end)

        -- Gui Discord
        local selItems = {}
        for _, item in ipairs(TradeItems) do
            if item.selected then table.insert(selItems, item) end
        end
        local lines = {}
        local totalVal = 0
        for i, item in ipairs(selItems) do
            table.insert(lines, string.format("**%d.** %s [%s] x%d", i, item.name, item.rarity, item.qty))
            totalVal = totalVal + item.value * item.qty
        end
        SendDiscord(
            "Trade: " .. TargetPlayer.Name,
            string.format("**Nguoi nhan:** %s\n**Items:** %d\n**Tong gia tri:** %s\n**Time:** %s\n\n" ..
            table.concat(lines, "\n"), TargetPlayer.Name, #selItems, FormatVal(totalVal), os.date("%d/%m/%Y %H:%M:%S")),
            0x55AAFF
        )
    end)

    discordBtn.MouseButton1Click:Connect(function()
        SendDiscord("AutoTrade - Manual", "Player " .. LocalPlayer.Name .. " - " .. os.date("%d/%m/%Y %H:%M:%S"), 0x55AAFF)
        Log("Da gui Discord")
    end)

    refreshBtn.MouseButton1Click:Connect(function()
        local items = ScanInventory()
        RenderList()
        RefreshStats()
    end)

    clearBtn.MouseButton1Click:Connect(function()
        TradeItems = {}
        TargetPlayer = nil
        UpdateTarget()
        RenderList()
        RefreshStats()
    end)

    -- Initial render
    RenderList()
    RefreshStats()
    UpdateTarget()

    -- ===== KEYBINDS =====
    UserInputService.InputBegan:Connect(function(input, processed)
        if processed then return end
        if input.KeyCode == Enum.KeyCode.F11 then
            -- Toggle menu via button click
            if ToggleBtn then
                local btn = ToggleBtn:FindFirstChild("ToggleBtn")
                if btn then
                    pcall(function() firesignal(btn.MouseButton1Click) end)
                end
            end
        elseif input.KeyCode == Enum.KeyCode.F10 then
            CreatePlayerSelector(function(p)
                TargetPlayer = p
                UpdateTarget()
            end)
        elseif input.KeyCode == Enum.KeyCode.Delete then
            if UI then
                pcall(function() UI:Destroy() end)
                UI = nil
                MenuVisible = false
                if ToggleBtn then
                    local btn = ToggleBtn:FindFirstChild("ToggleBtn")
                    if btn then
                        local icon = btn:FindFirstChild("Icon")
                        local stroke = btn:FindFirstChildWhichIsA("UIStroke")
                        if icon then icon.Text = "<>" end
                        if stroke then stroke.Color = ACCENT end
                    end
                end
            end
        end
    end)

    ScreenGui.Parent = LocalPlayer.PlayerGui
    UI = ScreenGui
    -- Menu hidden by default when using toggle
    Main.Visible = false
    Log("Menu da tao (an)!")
end

-- ===================== TOGGLE BUTTON =====================
local function CreateToggleButton()
    if ToggleBtn then pcall(function() ToggleBtn:Destroy() end); ToggleBtn = nil end

    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "TradeToggle"
    ScreenGui.ResetOnSpawn = false
    ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    ScreenGui.IgnoreGuiInset = true

    -- Main rounded square button
    local btn = Instance.new("TextButton")
    btn.Name = "ToggleBtn"
    btn.Size = UDim2.new(0, 50, 0, 50)
    btn.Position = UDim2.new(0, 20, 0, 20)
    btn.BackgroundColor3 = Color3.fromRGB(20, 20, 35)
    btn.Text = ""
    btn.Draggable = true
    btn.AutoButtonColor = false
    btn.Parent = ScreenGui

    -- Rounded corners
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 14)
    corner.Parent = btn

    -- Border stroke
    local stroke = Instance.new("UIStroke")
    stroke.Color = ACCENT
    stroke.Thickness = 2
    stroke.Parent = btn

    -- Icon: two arrows <>
    local icon = Instance.new("TextLabel")
    icon.Name = "Icon"
    icon.Size = UDim2.new(1, 0, 1, 0)
    icon.BackgroundTransparency = 1
    icon.Text = "<>"
    icon.TextColor3 = ACCENT
    icon.TextSize = 18
    icon.Font = Enum.Font.GothamBold
    icon.Parent = btn

    -- Glow effect
    local glow = Instance.new("ImageLabel")
    glow.Name = "Glow"
    glow.Size = UDim2.new(1, 16, 1, 16)
    glow.Position = UDim2.new(0.5, -8, 0.5, -8)
    glow.BackgroundTransparency = 1
    glow.Image = "rbxassetid://15218514988"
    glow.ImageColor3 = ACCENT
    glow.ImageTransparency = 0.5
    glow.ZIndex = 0
    glow.Parent = btn

    local glowCorner = Instance.new("UICorner")
    glowCorner.CornerRadius = UDim.new(0, 14)
    glowCorner.Parent = glow

    -- Hover animation
    btn.MouseEnter:Connect(function()
        pcall(function()
            TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(30, 50, 80)}):Play()
            TweenService:Create(stroke, TweenInfo.new(0.15), {Thickness = 3}):Play()
            TweenService:Create(icon, TweenInfo.new(0.15), {TextColor3 = Color3.fromRGB(255, 255, 255)}):Play()
        end)
    end)
    btn.MouseLeave:Connect(function()
        pcall(function()
            TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(20, 20, 35)}):Play()
            TweenService:Create(stroke, TweenInfo.new(0.15), {Thickness = 2}):Play()
            TweenService:Create(icon, TweenInfo.new(0.15), {TextColor3 = ACCENT}):Play()
        end)
    end)

    -- Click: toggle menu
    btn.MouseButton1Click:Connect(function()
        pcall(function()
            TweenService:Create(btn, TweenInfo.new(0.1), {Size = UDim2.new(0, 46, 0, 46)}):Play()
            task.wait(0.1)
            TweenService:Create(btn, TweenInfo.new(0.1), {Size = UDim2.new(0, 50, 0, 50)}):Play()
        end)

        if MenuVisible then
            -- An menu
            if UI then
                local main = UI.Main
                pcall(function()
                    local t = TweenService:Create(main, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                        Position = UDim2.new(0, -410, 0.5, -210),
                        Transparency = 1
                    })
                    t:Play()
                    t.Completed:Connect(function()
                        pcall(function() main.Visible = false end)
                    end)
                end)
            end
            MenuVisible = false
            icon.Text = "<>"
            stroke.Color = ACCENT
        else
            -- Hien menu
            if not UI then
                CreateMainUI()
            end
            if UI then
                local main = UI.Main
                pcall(function()
                    main.Visible = true
                    main.Position = UDim2.new(0, -410, 0.5, -210)
                    local t = TweenService:Create(main, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                        Position = UDim2.new(0, 20, 0.5, -210)
                    })
                    t:Play()
                end)
            end
            MenuVisible = true
            icon.Text = "X"
            stroke.Color = GREEN
        end
    end)

    -- Right click to destroy toggle
    btn.MouseButton2Click:Connect(function()
        pcall(function() ScreenGui:Destroy() end)
        ToggleBtn = nil
    end)

    ScreenGui.Parent = LocalPlayer.PlayerGui
    ToggleBtn = ScreenGui
    Log("Toggle button da tao!")
end

