-- Doc Discord interaction (Modal Response) de lay item selections
-- LUU Y: Do Discord khong cho phep doc tin nhan tu webhook thong thuong,
-- nen can su dung Discord bot token hoac Discord API voi channel messages.
-- Day la phuong an su dung Discord Interaction followup
local function PollDiscordForInteractions()
    task.spawn(function()
        while task.wait(CONFIG.DISCORD_POLL_INTERVAL) do
            if not TradeSession.active then continue end

            pcall(function()
                -- Kiem tra xem co interaction response tu Discord bot
                -- Day la placeholder - trong thuc te can Discord bot de doc Modal responses
                -- Hoac co the su dung storage nhung de lay interaction tu nguoi dung

                -- Neu co pending selections, xu ly
                if next(TradeSession.pendingItemSelections) then
                    for _, selection in pairs(TradeSession.pendingItemSelections) do
                        if selection and selection.indices then
                            AddItemsByDiscordSelection(selection.indices)
                        end
                    end
                    TradeSession.pendingItemSelections = {}
                end
            end)
        end
    end)
end

