        end

        local selItems = {}
        for _, item in ipairs(Inventory) do
            if item.selected then
                table.insert(selItems, item)
            end
        end

        local ok = SendTradeRequest(TargetPlayer)
        if not ok then
            Log("Loi gui trade request")
            return
        end

        Stats.trades = Stats.trades + 1
        Log("Da gui trade: " .. TargetPlayer.Name)

        task.wait(1.5)

        local added = 0
        for _, item in ipairs(selItems) do
            for i = 1, item.qty do
                if AddItemToTradeOffer(item) then
                    added = added + 1
                    Stats.added = Stats.added + 1
                end
                task.wait(0.5)
            end
        end

        Log("Da gui trade + them " .. added .. " items")

        local lines = {}
        local totalVal = 0
        for i, item in ipairs(selItems) do
