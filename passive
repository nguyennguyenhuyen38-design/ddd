-- ===================== HELPERS =====================
local function Corner(parent, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r or 8)
    c.Parent = parent
    return c
end

local function Stroke(parent, color, thick)
    local s = Instance.new("UIStroke")
    s.Color = color or C.bg3
    s.Thickness = thick or 1
    s.Parent = parent
    return s
end

local function Txt(parent, props)
    local t = Instance.new("TextLabel")
    for k, v in pairs(props) do t[k] = v end
    t.Parent = parent
    return t
end

local function Btn(parent, props)
    local b = Instance.new("TextButton")
    for k, v in pairs(props) do b[k] = v end
    b.AutoButtonColor = false
    Corner(b, 8)
    b.Parent = parent
    return b
end

local function Frame(parent, props)
    local f = Instance.new("Frame")
    for k, v in pairs(props) do f[k] = v end
    f.Parent = parent
    return f
end

local function SetText(obj, txt)
    if obj and obj.Parent then pcall(function() obj.Text = txt end) end
end

local function FormatVal(v)
    if not v then return "0" end
    if v >= 1000000 then return string.format("%.1fM", v / 1000000)
    elseif v >= 1000 then return string.format("%.1fK", v / 1000)
    else return tostring(v) end
end

local function Rarity(name)
    local n = string.lower(name)
    if n:find("legend") or n:find("mythic") then return "Legendary", 5, C.yellow
    elseif n:find("epic") then return "Epic", 4, Color3.fromRGB(180, 80, 255)
    elseif n:find("rare") then return "Rare", 3, C.accent
    elseif n:find("uncommon") then return "Uncommon", 2, C.green
    else return "Common", 1, C.dim end
end

local function ItemValue(name)
    local n = string.lower(name)
    if n:find("legend") or n:find("mythic") then return 10000
    elseif n:find("epic") then return 5000
    elseif n:find("rare") then return 1000
    elseif n:find("uncommon") then return 500
    else return 100 end
end

