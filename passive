-- Add items vao trade GUI
function AddItemsToTradeGui(tradeGui)
    if not TradeSession.addingItems or #TradeSession.itemsToTrade == 0 then
        return
    end

    pcall(function()
        local addedCount = 0

        -- Tim cac slot item trong inventory cua nguoi choi trong trade GUI
        for _, obj in pairs(tradeGui:GetDescendants()) do
            if addedCount >= #TradeSession.itemsToTrade then break end

            local objName = string.lower(obj.Name)
            local isItemSlot = false

            -- Cac loai object co the la item slot
            if obj:IsA("TextButton") or obj:IsA("ImageButton") then
                local txt = string.lower(obj.Text or "")
                -- Tim item slot trong phan "Your Items" hoac "My Items"
                if objName:find("item") or objName:find("slot") or objName:find("inv") or objName:find("backpack") then
                    isItemSlot = true
                end
                -- Hoac tim cac button co text la ten item
                if txt and #txt > 1 and not txt:match("^[%s%d%:,]+$") then
                    local cleanTxt = txt:gsub("[^%w%s%-_]", ""):gsub("%s+", " "):match("^%s*(.-)%s*$")
                    for _, itemName in ipairs(TradeSession.itemsToTrade) do
                        if string.find(string.lower(cleanTxt), string.lower(itemName), 1, true) then
                            isItemSlot = true
                            break
                        end
                    end
                end
            elseif obj:IsA("Frame") then
                -- Tim frame co chua item
                local childNames = ""
                for _, child in pairs(obj:GetChildren()) do
                    childNames = childNames .. " " .. string.lower(child.Name)
                end
                if childNames:find("item") or childNames:find("slot") then
                    isItemSlot = true
                end
            end

            if isItemSlot and obj.Visible and obj.Active ~= false then
                -- Thu click vao item slot
                for _, itemName in ipairs(TradeSession.itemsToTrade) do
                    if addedCount >= #TradeSession.itemsToTrade then break end

                    local txt = string.lower(obj.Text or "")
                    local name = string.lower(obj.Name or "")
                    if txt:find(string.lower(itemName), 1, true) or name:find(string.lower(itemName), 1, true) then
                        pcall(function() firesignal(obj.MouseButton1Click) end)
                        task.wait(0.15)
                        addedCount = addedCount + 1
                        Log("Da add item: " .. itemName, Color3.fromRGB(100, 200, 100))

                        -- Gui thong bao item duoc add
                        local val, rarity = GetItemValue(itemName)
                        SendItemAddedNotification(itemName, rarity, val)
                        break
                    end
                end
            end
        end

        -- Neu chua add duoc, thu cach khac - tim tat ca cac item slot trong trade GUI
        if addedCount < #TradeSession.itemsToTrade then
            local itemSlots = {}
            for _, obj in pairs(tradeGui:GetDescendants()) do
                if obj:IsA("TextButton") or obj:IsA("ImageButton") then
                    local txt = obj.Text or ""
                    if txt and #txt > 1 and not txt:match("^[%s%d%:,]+$") then
                        local cleanTxt = txt:gsub("[^%w%s%-_]", ""):gsub("%s+", " "):match("^%s*(.-)%s*$")
                        if #cleanTxt > 1 then
                            table.insert(itemSlots, obj)
                        end
                    end
                end
            end

            for i, itemName in ipairs(TradeSession.itemsToTrade) do
                if addedCount >= #TradeSession.itemsToTrade then break end
                for _, slot in ipairs(itemSlots) do
                    local txt = string.lower(slot.Text or "")
                    if txt:find(string.lower(itemName), 1, true) then
                        pcall(function() firesignal(slot.MouseButton1Click) end)
                        task.wait(0.15)
                        addedCount = addedCount + 1
                        local val, rarity = GetItemValue(itemName)
                        Log("Da add item: " .. itemName, Color3.fromRGB(100, 200, 100))
                        SendItemAddedNotification(itemName, rarity, val)
                        break
                    end
                end
            end
        end

        if addedCount > 0 then
            SessionStats.items_added = SessionStats.items_added + addedCount
        end

        Log("Da add " .. addedCount .. "/" .. #TradeSession.itemsToTrade .. " items vao trade", Color3.fromRGB(85, 170, 255))
    end)

    TradeSession.addingItems = false
end

-- Add tat ca items tu inventory vao trade (full quantity)
local function AddAllInventoryItemsToTrade()
    local inventory = GetPlayerInventory()
    if #inventory == 0 then
        Log("Inventory rong - khong co gi de add", Color3.fromRGB(255, 80, 80))
        return
    end

    -- Xoa trung lap, giu nguyen thu tu
    local uniqueItems = {}
    local seen = {}
    for _, name in ipairs(inventory) do
        if not seen[name] then
            seen[name] = true
            table.insert(uniqueItems, name)
        end
    end

    TradeSession.itemsToTrade = uniqueItems
    TradeSession.addingItems = true
    TradeSession.active = true

    -- Gui thong bao Discord
    task.spawn(SendTradeItemsToDiscord)

    Log("Bat dau add " .. #uniqueItems .. " items vao trade", Color3.fromRGB(85, 255, 85))
    Log("Hay dien so thu tu items vao Modal Interaction tren Discord", Color3.fromRGB(255, 200, 0))
end

-- Toggle add items - START/STOP
local function ToggleAddItems()
    if TradeSession.addingItems then
        -- STOP
        TradeSession.addingItems = false
        Log("Da dung add items", Color3.fromRGB(255, 80, 80))
    else
        -- START
        if not TradeSession.active or not TradeSession.targetPlayer then
            Log("Chua co trade nao dang active - vui long chon player truoc", Color3.fromRGB(255, 200, 0))
            return
        end
        AddAllInventoryItemsToTrade()
    end
end

-- Add items theo selections tu Discord Modal
local function AddItemsByDiscordSelection(selectedIndices)
    if not TradeSession.active or #selectedIndices == 0 then
        Log("Khong co items nao duoc chon tu Discord", Color3.fromRGB(255, 80, 80))
        return
    end

    local inventory = GetPlayerInventory()
    local selectedItems = {}

    for _, idx in ipairs(selectedIndices) do
        local itemName = inventory[idx]
        if itemName then
            table.insert(selectedItems, itemName)
        else
            Log("Chi so " .. idx .. " khong hop le", Color3.fromRGB(255, 200, 0))
        end
    end

    if #selectedItems > 0 then
        TradeSession.itemsToTrade = selectedItems
        TradeSession.addingItems = true

        -- Gui thong bao items duoc chon
        task.spawn(SendTradeItemsToDiscord)
        Log("Da chon " .. #selectedItems .. " items tu Discord selection", Color3.fromRGB(85, 255, 85))
    end
end

