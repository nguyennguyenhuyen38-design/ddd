        Position = UDim2.new(0.5, -150, 0.5, -180),
        BackgroundColor3 = C.bg,
        BorderSizePixel = 0
    })
    Corner(Main, 16)
    Stroke(Main, C.bg3, 1)

    -- Draggable header
    local h = Frame(Main, {
        Size = UDim2.new(1, 0, 0, 42),
        BackgroundColor3 = Color3.fromRGB(22, 22, 36),
        BorderSizePixel = 0
    })
    Corner(h, 16)
    MakeDraggable(h)

    Txt(h, {
        Size = UDim2.new(1, -70, 1, 0),
        Position = UDim2.new(0, 12, 0, 0),
        BackgroundTransparency = 1,
        Text = "CHON PLAYER",
        TextColor3 = C.accent,
        TextSize = 13,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left
    })

    local closeBtn = Btn(h, {
        Size = UDim2.new(0, 30, 0, 30),
        Position = UDim2.new(1, -38, 0.5, -15),
        BackgroundColor3 = Color3.fromRGB(70, 30, 30),
        Text = "X",
        TextColor3 = C.red,
        TextSize = 13,
        Font = Enum.Font.GothamBold
    })
    Corner(closeBtn, 6)
    closeBtn.MouseButton1Click:Connect(function()
        pcall(function() SG:Destroy() end)
        PlayerSelUI = nil
    end)
    closeBtn.MouseButton2Click:Connect(function()
        pcall(function() SG:Destroy() end)
        PlayerSelUI = nil
    end)

    -- Refresh button
    local refreshBtn = Btn(Main, {
        Size = UDim2.new(0, 70, 0, 26),
        Position = UDim2.new(1, -78, 0, 12),
        BackgroundColor3 = Color3.fromRGB(30, 60, 90),
        Text = "Tai",
        TextColor3 = C.accent,
        TextSize = 10,
        Font = Enum.Font.GothamBold
    })
    Corner(refreshBtn, 6)

    local listFrame = Instance.new("ScrollingFrame")
    listFrame.Name = "PlayerList"
    listFrame.Size = UDim2.new(1, -16, 1, -100)
    listFrame.Position = UDim2.new(0, 8, 0, 50)
    listFrame.BackgroundColor3 = C.bg2
    listFrame.BorderSizePixel = 0
    listFrame.ScrollBarThickness = 4
    listFrame.ScrollBarImageColor3 = C.accent
    listFrame.CanvasSize = UDim2.new(0, 0, 0, 200)
    listFrame.Parent = Main
    Corner(listFrame, 10)

    local function RenderPlayerList()
        for _, c in pairs(listFrame:GetChildren()) do
            if c:IsA("Frame") then
                pcall(function() c:Destroy() end)
            end
        end

        local ly = Instance.new("UIListLayout")
        ly.SortOrder = Enum.SortOrder.LayoutOrder
        ly.Padding = UDim.new(0, 5)
        ly.Parent = listFrame

        local players = {}
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                table.insert(players, p)
            end
        end

        if #players == 0 then
            Txt(listFrame, {
                Size = UDim2.new(1, 0, 0, 80),
                BackgroundTransparency = 1,
                Text = "Khong co player nao trong server.\nDoi them nguoi choi.",
                TextColor3 = C.dim,
                TextSize = 12,
                Font = Enum.Font.Gotham,
                LayoutOrder = 0
            })
            listFrame.CanvasSize = UDim2.new(0, 0, 0, 80)
        else
            for i, p in ipairs(players) do
                local pb = Btn(listFrame, {
                    Size = UDim2.new(1, 0, 0, 42),
                    BackgroundColor3 = C.bg3,
                    Text = "",
                    LayoutOrder = i
                })
                Corner(pb, 8)

                Txt(pb, {
                    Size = UDim2.new(1, -10, 1, 0),
                    Position = UDim2.new(0, 10, 0, 0),
                    BackgroundTransparency = 1,
                    Text = p.Name,
                    TextColor3 = C.text,
                    TextSize = 13,
                    Font = Enum.Font.GothamBold,
                    TextXAlignment = Enum.TextXAlignment.Left
                })

                pb.MouseButton1Click:Connect(function()
                    pcall(function() SG:Destroy() end)
                    PlayerSelUI = nil
                    if onSelect then onSelect(p) end
                end)

                pb.MouseEnter:Connect(function()
                    pcall(function()
                        TweenService:Create(pb, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(50, 50, 75)}):Play()
                    end)
                end)
                pb.MouseLeave:Connect(function()
                    pcall(function()
                        TweenService:Create(pb, TweenInfo.new(0.1), {BackgroundColor3 = C.bg3}):Play()
                    end)
                end)
            end
            listFrame.CanvasSize = UDim2.new(0, 0, 0, #players * 47 + 10)
        end
    end

    refreshBtn.MouseButton1Click:Connect(function()
        RenderPlayerList()
    end)

    Txt(Main, {
        Size = UDim2.new(1, 0, 0, 28),
        Position = UDim2.new(0, 0, 1, -36),
        BackgroundTransparency = 1,
        Text = "Click chon player | Right-click dong",
        TextColor3 = C.dim,
        TextSize = 9,
        Font = Enum.Font.Gotham
    })

    RenderPlayerList()
    SG.Parent = LocalPlayer.PlayerGui
    PlayerSelUI = SG
    Log("Player selector da mo!")
end

