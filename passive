-- JJSPoit hỗ trợ loadstring, nhưng nếu không hoạt động thì dùng request
local function fetchUI(url)
    local success, result = pcall(function()
        -- Thử cách 1: game:HttpGet (JJSPoit hỗ trợ)
        return loadstring(game:HttpGet(url))()
    end)
    if success then
        return result
    end

    -- Thử cách 2: syn.request (JJSPoit hỗ trợ)
    success, result = pcall(function()
        local req = syn.request or http_request or (http and http.request)
        if req then
            local response = req({
                Url = url,
                Method = "GET"
            })
            if response and response.Body then
                return loadstring(response.Body)()
            end
        end
        error("HTTP request failed")
    end)
    if success then
        return result
    end

    return nil, "Failed to load UI library"
end

