-- ===================== INVENTORY SCANNER =====================
local function ScanInventory()
    TradeItems = {}
    Log("Bat dau quet inventory...")

    local found = {}

    -- THU 1: Tim inventory GUI trong PlayerGui
    local function searchGui(gui, depth)
        if depth > 4 then return end
        pcall(function()
            for _, c in pairs(gui:GetChildren()) do
                pcall(function()
                    local cn = string.lower(c.Name)
                    local isContainer = false

                    if c:IsA("ScrollingFrame") or c:IsA("Frame") then
                        if cn:find("inv") or cn:find("item") or cn:find("slot") or cn:find("backpack") or cn:find("bag") then
                            isContainer = true
                        end
                    end

                    -- Lay text tu TextLabel/TextButton
                    if c:IsA("TextLabel") or c:IsA("TextButton") then
                        local txt = c.Text
                        if txt and type(txt) == "string" and #txt > 1 and #txt < 60 and not txt:match("^[%s%d%:,%.%-%+]+$") then
                            local clean = txt:gsub("[^%w%s%-_']", ""):gsub("%s+", " "):match("^%s*(.-)%s*$")
                            if #clean > 2 then
                                found[clean] = true
                            end
                        end
                    end

                    -- Lay name tu ImageLabel/ImageButton
                    if c:IsA("ImageLabel") or c:IsA("ImageButton") then
                        local nm = c.Name
                        if nm and type(nm) == "string" and #nm > 2 and #nm < 60 and not nm:match("^[%s%d]+$") and not nm:match("^rbx") then
                            found[nm] = true
                        end
                    end

                    -- De quy tiep
                    if isContainer or depth < 2 then
                        searchGui(c, depth + 1)
                    end
                end)
            end
        end)
    end

    -- Tim tat ca GUI
    for _, gui in pairs(LocalPlayer.PlayerGui:GetChildren()) do
        if gui:IsA("ScreenGui") then
            pcall(function() searchGui(gui, 0) end)
        end
    end

    -- Tim trong ReplicatedStorage / Character
    if LocalPlayer.Character then
        pcall(function() searchGui(LocalPlayer.Character, 0) end)
    end

    for name in pairs(found) do
        local rarity, tier = RarityFromName(name)
        local value = ValueFromName(name)
        table.insert(TradeItems, {name = name, qty = 1, selected = false, rarity = rarity, tier = tier, value = value})
    end

    -- Sort theo rarity va name
    table.sort(TradeItems, function(a, b)
        if a.tier ~= b.tier then return a.tier > b.tier end
        return a.name < b.name
    end)

    LogOk("Quet xong - Tim thay " .. #TradeItems .. " items")
    return TradeItems
end

-- ===================== TRADE SYSTEM =====================
local function FindTradeRemote()
    local candidates = {}
    for _, obj in pairs(ReplicatedStorage:GetChildren()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            local n = string.lower(obj.Name)
            if n:find("trade") then
                table.insert(candidates, obj)
            end
        end
    end
    if #candidates > 0 then
        -- Tim cai phu hop nhat
        for _, c in ipairs(candidates) do
            local n = string.lower(c.Name)
            if n == "trade" or n == "traderemote" or n == "sendtrade" or n:find("tradereq") then
                return c
            end
        end
        return candidates[1]
    end
    return nil
end

local function SendTradeToPlayer(player)
    if not player then LogErr("Chua chon player"); return false end
    Log("Dang gui trade toi: " .. player.Name)

    local remote = FindTradeRemote()
    if remote then
        Log("Tim thay remote: " .. remote.Name)
        pcall(function()
            if remote:IsA("RemoteFunction") then
                pcall(function() remote:CallServerAsync(player) end)
            else
                pcall(function() remote:FireServer(player) end)
            end
        end)
    else
        Log("Khong tim remote - thu tim nut Trade trong GUI")
    end

    Stats.trades_sent = Stats.trades_sent + 1
    return true
end

local function AddItemsInTradeGui()
    local addedCount = 0
    local totalValue = 0
    TradeOpen = false

    pcall(function()
        -- Doi trade GUI xuat hien
        for i = 1, 20 do
            task.wait(0.3)
            for _, gui in pairs(LocalPlayer.PlayerGui:GetChildren()) do
                if gui:IsA("ScreenGui") then
                    local gn = string.lower(gui.Name)
                    if gn:find("trade") then
                        TradeOpen = true
                        -- Tim item slots trong trade GUI
                        for _, obj in pairs(gui:GetDescendants()) do
                            if obj:IsA("TextButton") or obj:IsA("ImageButton") then
                                local txt = obj.Text or ""
                                local nm = obj.Name or ""
                                for _, item in ipairs(TradeItems) do
                                    if item.selected and item.qty > 0 then
                                        local lowTxt = string.lower(txt)
                                        local lowNm = string.lower(nm)
                                        local lowItem = string.lower(item.name)
                                        if lowTxt:find(lowItem, 1, true) or lowNm:find(lowItem, 1, true) then
                                            pcall(function() firesignal(obj.MouseButton1Click) end)
                                            task.wait(0.1)
                                            addedCount = addedCount + 1
                                            totalValue = totalValue + item.value
                                            break
                                        end
                                    end
                                end
                            end
                        end
                        break
                    end
                end
            end
            if TradeOpen then break end
        end
    end)

    if addedCount > 0 then
        Stats.items_added = Stats.items_added + addedCount
        Stats.total_value = Stats.total_value + totalValue
        LogOk("Da add " .. addedCount .. " items (gia tri: " .. FormatVal(totalValue) .. ")")
    else
        LogErr("Khong add duoc item nao - hay mo trade GUI truoc")
    end

    return addedCount
end

-- ===================== GUI BUILDING HELPERS =====================
local function MakeCorner(parent, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 8)
    c.Parent = parent
    return c
end

local function MakeStroke(parent, color)
    local s = Instance.new("UIStroke")
    s.Color = color or BG3
    s.Thickness = 1
    s.Parent = parent
    return s
end

local function MakeLabel(parent, props)
    local l = Instance.new("TextLabel")
    for k, v in pairs(props) do l[k] = v end
    l.Parent = parent
    return l
end

local function MakeBtn(parent, props)
    local b = Instance.new("TextButton")
    for k, v in pairs(props) do b[k] = v end
    MakeCorner(b, 8)
    b.AutoButtonColor = true
    return b
end

local function SlideIn(frame, fromRight)
    pcall(function()
        local start = fromRight and UDim2.new(1, 50, 0.5, -200) or UDim2.new(0, -50, 0.5, -200)
        frame.Position = start
        frame.Size = UDim2.new(0, 400, 0, 420)
        frame.Visible = true
        local t = TweenService:Create(frame, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Position = UDim2.new(0, 20, 0.5, -210),
            Size = UDim2.new(0, 400, 0, 420)
        })
        t:Play()
    end)
end

local function SlideOut(frame, cb)
    pcall(function()
        local t = TweenService:Create(frame, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Position = UDim2.new(0, -50, 0.5, -210),
            Transparency = 1
        })
        t:Play()
        t.Completed:Connect(function()
            pcall(function() frame:Destroy() end)
            if cb then cb() end
        end)
    end)
end

