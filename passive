-- ===================== ANTI AFK =====================

local function SetupAntiAfk()
    if not CONFIG.ANTI_AFK then return end

    LocalPlayer.Idled:Connect(function()
        if CONFIG.ANTI_AFK and VirtualInputManager then
            pcall(function()
                VirtualInputManager:SendCoreKeyboardEvent(Enum.KeyCode.F9, true, false, game)
                task.wait()
                VirtualInputManager:SendCoreKeyboardEvent(Enum.KeyCode.F9, false, false, game)
            end)
        end
    end)

    RunService.Heartbeat:Connect(function()
        -- Anti AFK via Heartbeat disabled - chi su dung Idled event
    end)

    Log("Anti AFK da bat")
end

-- ===================== AUTO REJOIN =====================

local function AutoRejoin()
    if not CONFIG.AUTO_REJOIN then return end

    Log("Mat ket noi - Bat dau auto rejoin...", Color3.fromRGB(255, 80, 80))

    task.wait(3)

    local jobId = game.JobId
    local servers = {}

    pcall(function()
        local resp = HttpService:GetAsync("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortFilter=2&limit=100")
        local data = HttpService:JSONDecode(resp)
        if data and data.data then
            for _, server in ipairs(data.data) do
                if server.id ~= jobId then
                    table.insert(servers, server.id)
                end
            end
        end
    end)

    task.wait(2)

    if #servers > 0 then
        local chosen = servers[math.random(1, #servers)]
        Log("Rejoin server: " .. chosen)
        TeleportService:TeleportToPlaceInstance(game.PlaceId, chosen, LocalPlayer)
    else
        Log("Khong tim thay server - Teleport ve lobby...")
        TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
    end
end

game:GetService("NetworkClient").ChildRemoved:Connect(function(child)
    if child:IsA("Player") and child.Name == LocalPlayer.Name then
        AutoRejoin()
    end
end)

