    end)

    -- Update loop
    task.spawn(function()
        while true do
            task.wait(1.5)
            pcall(function()
                if not MenuGui or not MenuGui.Parent then break end
                local mf = MenuGui:FindFirstChild("Main")
                if not mf then break end

                -- Update target name
                local tn = mf.TargetFrame and mf.TargetFrame:FindFirstChild("TargetName")
                if tn then
                    if TargetPlayerName ~= "" then
                        tn.Text = TargetPlayerName
                        tn.TextColor3 = Color3.fromRGB(85, 255, 85)
                    else
                        tn.Text = "Chua chon player"
                        tn.TextColor3 = Color3.fromRGB(160, 160, 160)
                    end
                end

                -- Update inventory
                local invFrame = mf:FindFirstChild("InvFrame")
                if invFrame then
                    local cnt = invFrame:FindFirstChild("InvCount")
                    local lst = invFrame:FindFirstChild("InvList")
                    if cnt then cnt.Text = "Tong items: " .. #InventoryList end
                    if lst then
                        if #InventoryList > 0 then
                            local lines = {}
                            for i = 1, math.min(#InventoryList, 5) do
                                local item = InventoryList[i]
                                table.insert(lines, string.format("%d. %s [%s]", i, item.name, item.rarity))
                            end
                            if #InventoryList > 5 then
                                table.insert(lines, string.format("... va %d items khac", #InventoryList - 5))
                            end
                            lst.Text = table.concat(lines, "\n")
                        else
                            lst.Text = "(Nhan 'Quet' de lay danh sach)"
                        end
                    end
                end

                -- Update stats
                local function upStat(name, val)
                    local s = mf:FindFirstChild(name)
                    if s then s.Text = tostring(val) end
                end
                upStat("StatTrades", Stats.trades_sent)
                upStat("StatItems", Stats.items_added)
                upStat("StatInv", #InventoryList)
            end)
            if not MenuGui then break end
        end
    end)

    ScreenGui.Parent = LocalPlayer.PlayerGui
    MenuGui = ScreenGui

    -- Keyboard
    UserInputService.InputBegan:Connect(function(input, processed)
        if input.KeyCode == Enum.KeyCode.Delete then
            if MenuGui then
                pcall(function() MenuGui:Destroy() end)
                MenuGui = nil
            end
        elseif input.KeyCode == Enum.KeyCode.F11 then
            if MenuGui then
                pcall(function() MenuGui:Destroy() end)
                MenuGui = nil
            else
                CreateMainUI()
            end
        elseif input.KeyCode == Enum.KeyCode.F10 then
            CreatePlayerSelector()
        end
    end)

    Log("Menu da tao!")
end

