local function GetRarity(name)
    local n = string.lower(name)
    if n:find("legend") or n:find("mythic") then return "Legendary", 5
    elseif n:find("epic") then return "Epic", 4
    elseif n:find("rare") then return "Rare", 3
    elseif n:find("uncommon") then return "Uncommon", 2
    else return "Common", 1 end
end

local function GetValue(name)
    local n = string.lower(name)
    if n:find("legend") or n:find("mythic") then return 10000
    elseif n:find("epic") then return 5000
    elseif n:find("rare") then return 1000
    elseif n:find("uncommon") then return 500
    else return 100 end
end

local function FormatVal(v)
    if v >= 1000000 then return string.format("%.1fM", v / 1000000)
    elseif v >= 1000 then return string.format("%.1fK", v / 1000)
    else return tostring(v) end
end

-- ===================== INVENTORY SCAN =====================
local function ScanInventory()
    InventoryList = {}
    Log("Dang quet inventory...")

    pcall(function()
        -- Thu nhieu cach de lay inventory
        local candidates = {}

        -- Cach 1: Tim trong PlayerGui
        for _, gui in pairs(LocalPlayer.PlayerGui:GetChildren()) do
            if gui:IsA("ScreenGui") then
                local gn = string.lower(gui.Name)
                if gn:find("inventory") or gn:find("backpack") or gn:find("bag") or gn:find("item") then
                    table.insert(candidates, gui)
                end
                for _, child in pairs(gui:GetDescendants()) do
                    local cn = string.lower(child.Name)
                    if cn:find("inventory") or cn:find("backpack") or cn:find("slot") then
                        table.insert(candidates, child)
                    end
                end
            end
        end

        -- Cach 2: Tim trong Character
        if LocalPlayer.Character then
            for _, obj in pairs(LocalPlayer.Character:GetDescendants()) do
                if obj:IsA("Frame") or obj:IsA("ScrollingFrame") then
                    local cn = string.lower(obj.Name)
                    if cn:find("inventory") or cn:find("backpack") or cn:find("slot") then
                        table.insert(candidates, obj)
                    end
                end
            end
        end

        -- Trích xuat ten item tu cac candidate
        for _, cand in ipairs(candidates) do
            pcall(function()
                for _, obj in pairs(cand:GetDescendants()) do
                    local itemName = nil

                    if obj:IsA("TextLabel") or obj:IsA("TextButton") then
                        local txt = obj.Text
                        if txt and #txt > 1 and not txt:match("^[%s%d%:,]+$") then
                            local clean = txt:gsub("[^%w%s%-_]", ""):gsub("%s+", " "):match("^%s*(.-)%s*$")
                            if #clean > 2 and #clean < 50 then
                                itemName = clean
                            end
                        end
                    elseif obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
                        local name = obj.Name
                        if name and #name > 2 and not name:match("^[%s%d]+$") then
                            itemName = name
                        end
                    end

                    if itemName then
                        -- Kiem tra trung lap
                        local found = false
                        for _, existing in ipairs(InventoryList) do
                            if string.lower(existing.name) == string.lower(itemName) then
                                found = true
                                break
                            end
                        end
                        if not found then
                            local rarity, tier = GetRarity(itemName)
                            local value = GetValue(itemName)
                            table.insert(InventoryList, {name = itemName, rarity = rarity, tier = tier, value = value})
                        end
                    end
                end
            end)
        end
    end)

    Log("Quet xong - Tim thay " .. #InventoryList .. " items")
    return InventoryList
end

-- ===================== TRADE SYSTEM =====================
local function GetTradeRemote()
    local remote = nil
    pcall(function()
        for _, obj in pairs(ReplicatedStorage:GetChildren()) do
            if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
                local n = string.lower(obj.Name)
                if n:find("trade") and not n:find("accept") then
                    remote = obj
                    break
                end
            end
        end
    end)
    return remote
end

local function SendTradeRequest(playerName)
    Log("Dang gui trade request toi: " .. playerName)
    local remote = GetTradeRemote()

    if remote then
        Log("Tim thay remote: " .. remote.Name)
        pcall(function()
            if remote:IsA("RemoteFunction") then
                local ok, err = pcall(function()
                    remote:CallServerAsync(playerName)
                end)
                if not ok then LogError("Remote call failed: " .. tostring(err)) end
            else
                local ok, err = pcall(function()
                    remote:FireServer(playerName)
                end)
                if not ok then LogError("Remote fire failed: " .. tostring(err)) end
            end
        end)
    else
        LogError("Khong tim thay trade remote!")
        -- Thu mo trade bang cach nhan phim hoac tim button
        pcall(function()
            for _, gui in pairs(LocalPlayer.PlayerGui:GetChildren()) do
                if gui:IsA("ScreenGui") then
                    for _, obj in pairs(gui:GetDescendants()) do
                        if obj:IsA("TextButton") or obj:IsA("ImageButton") then
                            local txt = string.lower(obj.Text or "")
                            if txt:find("trade") and not txt:find("cancel") then
                                pcall(function() firesignal(obj.MouseButton1Click) end)
                            end
                        end
                    end
                end
            end
        end)
    end

    Stats.trades_sent = Stats.trades_sent + 1
    Log("Da gui trade request!")
end

local function AddItemsToTrade()
    Log("Dang add items vao trade...")

    local tradeGui = nil
    pcall(function()
        for _, gui in pairs(LocalPlayer.PlayerGui:GetChildren()) do
            if gui:IsA("ScreenGui") and string.lower(gui.Name):find("trade") then
                tradeGui = gui
                break
            end
        end
    end)

    if not tradeGui then
        LogError("Khong tim thay Trade GUI! Hay mo trade truoc.")
        return
    end

    local addedCount = 0

    pcall(function()
        -- Tim tat ca cac button/label co ten item trong trade GUI
        for _, obj in pairs(tradeGui:GetDescendants()) do
            if obj:IsA("TextButton") or obj:IsA("ImageButton") or obj:IsA("TextLabel") then
                local txt = obj.Text or ""
                if txt and #txt > 1 and not txt:match("^[%s%d%:,]+$") then
                    local clean = txt:gsub("[^%w%s%-_]", ""):gsub("%s+", " "):match("^%s*(.-)%s*$")
                    if #clean > 2 and #clean < 50 then
                        -- Kiem tra xem ten item co trong danh sach can add
                        for _, item in ipairs(ItemsToTrade) do
                            if string.find(string.lower(clean), string.lower(item.name), 1, true) then
                                -- Day la item slot - thu click
                                if obj:IsA("TextButton") or obj:IsA("ImageButton") then
                                    pcall(function() firesignal(obj.MouseButton1Click) end)
                                    task.wait(0.1)
                                    addedCount = addedCount + 1
                                    Log("Add: " .. item.name)
                                end
                            end
