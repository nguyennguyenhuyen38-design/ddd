    local SG = Instance.new("ScreenGui")
    SG.Name = "PlayerSel"
    SG.ResetOnSpawn = false
    SG.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

    local Main = Frame(SG, {
        Size = UDim2.new(0, 300, 0, 340),
        Position = UDim2.new(0.5, -150, 0.5, -170),
        BackgroundColor3 = C.bg,
        BorderSizePixel = 0
    })
    Main.Draggable = true
    Corner(Main, 16)
    Stroke(Main, C.bg3, 1)

    local h = Frame(Main, {
        Size = UDim2.new(1, 0, 0, 42),
        BackgroundColor3 = Color3.fromRGB(22, 22, 36),
        BorderSizePixel = 0
    })
    Corner(h, 16)

    Txt(h, {
        Size = UDim2.new(1, -70, 1, 0),
        Position = UDim2.new(0, 12, 0, 0),
        BackgroundTransparency = 1,
        Text = "CHON PLAYER",
        TextColor3 = C.accent,
        TextSize = 13,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left
    })

    local closeBtn = Btn(h, {
        Size = UDim2.new(0, 30, 0, 30),
        Position = UDim2.new(1, -38, 0.5, -15),
        BackgroundColor3 = Color3.fromRGB(70, 30, 30),
        Text = "X",
        TextColor3 = C.red,
        TextSize = 13,
        Font = Enum.Font.GothamBold
    })
    Corner(closeBtn, 6)
    closeBtn.MouseButton1Click:Connect(function()
        pcall(function() SG:Destroy() end)
        PlayerSelUI = nil
    end)

    local listFrame = Instance.new("ScrollingFrame")
    listFrame.Size = UDim2.new(1, -16, 1, -100)
    listFrame.Position = UDim2.new(0, 8, 0, 50)
    listFrame.BackgroundColor3 = C.bg2
    listFrame.BorderSizePixel = 0
    listFrame.ScrollBarThickness = 4
    listFrame.ScrollBarImageColor3 = C.accent
    listFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
    listFrame.Parent = Main
    Corner(listFrame, 10)

    local ly = Instance.new("UIListLayout")
    ly.SortOrder = Enum.SortOrder.LayoutOrder
    ly.Padding = UDim.new(0, 5)
    ly.Parent = listFrame

    local players = {}
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then table.insert(players, p) end
    end

    if #players == 0 then
        Txt(listFrame, {
            Size = UDim2.new(1, 0, 0, 80),
            BackgroundTransparency = 1,
            Text = "Khong co player nao.\nDoi them nguoi choi.",
            TextColor3 = C.dim,
            TextSize = 11,
            Font = Enum.Font.Gotham,
            LayoutOrder = 0
        })
    else
        for i, p in ipairs(players) do
            local pb = Btn(listFrame, {
                Size = UDim2.new(1, 0, 0, 40),
                BackgroundColor3 = C.bg3,
                Text = "",
                LayoutOrder = i
            })
            Corner(pb, 8)

            Txt(pb, {
                Size = UDim2.new(1, -10, 1, 0),
                Position = UDim2.new(0, 10, 0, 0),
                BackgroundTransparency = 1,
                Text = p.Name,
                TextColor3 = C.text,
                TextSize = 13,
                Font = Enum.Font.GothamBold,
                TextXAlignment = Enum.TextXAlignment.Left
            })

            pb.MouseButton1Click:Connect(function()
                pcall(function() SG:Destroy() end)
                PlayerSelUI = nil
                if onSelect then onSelect(p) end
            end)

            pb.MouseEnter:Connect(function()
                pcall(function()
                    TweenService:Create(pb, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(50, 50, 75)}):Play()
                end)
            end)
            pb.MouseLeave:Connect(function()
                pcall(function()
                    TweenService:Create(pb, TweenInfo.new(0.1), {BackgroundColor3 = C.bg3}):Play()
                end)
            end)
        end
        listFrame.CanvasSize = UDim2.new(0, 0, 0, #players * 45 + 10)
    end

    Txt(Main, {
        Size = UDim2.new(1, 0, 0, 28),
        Position = UDim2.new(0, 0, 1, -36),
        BackgroundTransparency = 1,
        Text = "Right-click de dong",
        TextColor3 = C.dim,
        TextSize = 9,
        Font = Enum.Font.Gotham
    })

    SG.Parent = LocalPlayer.PlayerGui
    PlayerSelUI = SG
end

