-- ===================== INVENTORY SCANNER =====================
local function ScanInventory()
    Inventory = {}
    Log("Bat dau quet inventory...")

    -- Tim inventory data trong game
    local candidates = {}

    -- 1. Tim trong ReplicatedStorage
    for _, obj in pairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("Folder") or obj:IsA("ModuleScript") then
            local n = string.lower(obj.Name)
            if n:find("inventory") or n:find("item") or n:find("backpack") then
                table.insert(candidates, obj)
            end
        end
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            local n = string.lower(obj.Name)
            if n:find("inventory") or n:find("item") or n:find("backpack") then
                table.insert(candidates, obj)
            end
        end
    end

    -- 2. Tim trong Workspace
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("Folder") or obj:IsA("ModuleScript") then
            local n = string.lower(obj.Name)
            if n:find("inventory") or n:find("item") or n:find("backpack") then
                table.insert(candidates, obj)
            end
        end
    end

    -- 3. Tim trong Player
    pcall(function()
        local inv = LocalPlayer:FindFirstChild("Inventory")
            or LocalPlayer:FindFirstChild("Backpack")
            or LocalPlayer:FindFirstChild("Items")
            or LocalPlayer:FindFirstChild("Data")
        if inv then
            table.insert(candidates, inv)
            Log("Tim thay folder: " .. inv.Name)
        end
    end)

    -- Doc du lieu tu cac candidate
    for _, cand in ipairs(candidates) do
        pcall(function()
            -- Doc tung child cua candidate
            for _, child in pairs(cand:GetChildren()) do
                local name = child.Name
                if name and #name > 1 and #name < 50 and not name:match("^[%s%d]+$") then
                    local rarity, tier = Rarity(name)
                    local value = ItemValue(name)
                    table.insert(Inventory, {
                        name = name,
                        rarity = rarity,
                        tier = tier,
                        value = value,
                        selected = false,
                        qty = 1
                    })
                end
                -- Neu la folder, doc tiep
                if child:IsA("Folder") then
                    for _, sub in pairs(child:GetChildren()) do
                        local nm = sub.Name
                        if nm and #nm > 1 and #nm < 50 and not nm:match("^[%s%d]+$") then
                            local rarity, tier = Rarity(nm)
                            local value = ItemValue(nm)
                            table.insert(Inventory, {
                                name = nm,
                                rarity = rarity,
                                tier = tier,
                                value = value,
                                selected = false,
                                qty = 1
                            })
                        end
                    end
                end
            end
        end)
    end

    -- 4. Doc tu GetPlayers (neu co RemoteFunction)
    pcall(function()
        local remotes = ReplicatedStorage:GetChildren()
        for _, r in pairs(remotes) do
            if r:IsA("RemoteFunction") then
                local n = string.lower(r.Name)
                if n:find("get") and (n:find("inv") or n:find("item") or n:find("player")) then
                    local ok, result = pcall(function()
                        return r:CallServerAsync()
                    end)
                    if ok and result then
                        Log("Remote tra ve: " .. type(result))
                    end
                end
            end
        end
    end)

    -- Xoa trung lap
    local seen = {}
    local unique = {}
    for _, item in ipairs(Inventory) do
        local key = string.lower(item.name)
        if not seen[key] then
            seen[key] = true
            table.insert(unique, item)
        end
    end
    Inventory = unique

    -- Sort theo rarity
    table.sort(Inventory, function(a, b)
        if a.tier ~= b.tier then return a.tier > b.tier end
        return a.name < b.name
    end)

    Log("Quet xong - " .. #Inventory .. " items")
    return Inventory
end

-- ===================== RENDER ITEM LIST =====================
local function RenderItems(scrollFrame, refreshFn)
    -- Xoa het child cu
    for _, c in pairs(scrollFrame:GetChildren()) do
        if c:IsA("Frame") or c:IsA("TextLabel") or c:IsA("TextButton") then
            pcall(function() c:Destroy() end)
        end
    end

    local ly = Instance.new("UIListLayout")
    ly.SortOrder = Enum.SortOrder.LayoutOrder
    ly.Padding = UDim.new(0, 3)
    ly.Parent = scrollFrame

    if #Inventory == 0 then
        Txt(scrollFrame, {
            Size = UDim2.new(1, 0, 0, 80),
            BackgroundTransparency = 1,
            Text = "Chua co item nao.\n\nNhan nut [QUET] ben duoi\nde tim items trong game.",
            TextColor3 = C.dim,
            TextSize = 11,
            Font = Enum.Font.Gotham,
            TextYAlignment = Enum.TextYAlignment.Center,
            LayoutOrder = 0
        })
        scrollFrame.CanvasSize = UDim2.new(0, 0, 0, 100)
        return
    end

    for i, item in ipairs(Inventory) do
        local sel = item.selected
        local row = Frame(scrollFrame, {
            Size = UDim2.new(1, 0, 0, 48),
            BackgroundColor3 = sel and Color3.fromRGB(25, 50, 30) or (i % 2 == 0 and C.bg3 or C.bg2),
            BorderSizePixel = 0,
            LayoutOrder = i
        })
        Corner(row, 6)
        if sel then Stroke(row, C.green, 1) end

        -- Checkbox
        local cb = Btn(row, {
            Size = UDim2.new(0, 32, 0, 32),
            Position = UDim2.new(0, 6, 0.5, -16),
            BackgroundColor3 = sel and Color3.fromRGB(50, 150, 50) or C.bg3,
            Text = sel and "Y" or "",
            TextColor3 = Color3.fromRGB(255, 255, 255),
            TextSize = 14,
            Font = Enum.Font.GothamBold
        })
        Corner(cb, 6)
        cb.MouseButton1Click:Connect(function()
            item.selected = not item.selected
            if item.selected then item.qty = 1 end
            RenderItems(scrollFrame, refreshFn)
            if refreshFn then refreshFn() end
        end)

        -- Name + rarity
        local rColor = Rarity(item.name)
        Txt(row, {
            Size = UDim2.new(1, -140, 0, 20),
            Position = UDim2.new(0, 44, 0, 5),
            BackgroundTransparency = 1,
            Text = item.name,
            TextColor3 = sel and Color3.fromRGB(255, 255, 255) or rColor,
            TextSize = 11,
            Font = Enum.Font.GothamBold,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd
        })
        Txt(row, {
            Size = UDim2.new(1, -140, 0, 14),
            Position = UDim2.new(0, 44, 0, 25),
            BackgroundTransparency = 1,
            Text = item.rarity .. " | " .. FormatVal(item.value),
            TextColor3 = C.dim,
            TextSize = 9,
            Font = Enum.Font.Gotham,
            TextXAlignment = Enum.TextXAlignment.Left
        })

        -- Qty +/-
        local qf = Frame(row, {
            Size = UDim2.new(0, 80, 0, 28),
            Position = UDim2.new(1, -86, 0.5, -14),
            BackgroundTransparency = 1
        })

        local function qtyBtn(txt, onClick)
            local b = Btn(qf, {
                Size = UDim2.new(0, 24, 1, 0),
                BackgroundColor3 = C.bg3,
                Text = txt,
                TextColor3 = sel and C.text or C.dim,
                TextSize = 14,
                Font = Enum.Font.GothamBold
            })
            Corner(b, 4)
            b.MouseButton1Click:Connect(onClick)
            return b
        end

        qtyBtn("-", function()
            if sel and item.qty > 1 then
                item.qty = item.qty - 1
                RenderItems(scrollFrame, refreshFn)
                if refreshFn then refreshFn() end
            end
        end)

        local ql = Txt(qf, {
            Size = UDim2.new(0, 32, 1, 0),
            Position = UDim2.new(0, 24, 0, 0),
            BackgroundColor3 = C.bg3,
            Text = "x" .. item.qty,
            TextColor3 = sel and C.accent or C.dim,
            TextSize = 11,
            Font = Enum.Font.GothamBold
        })
        Corner(ql, 4)

        qtyBtn("+", function()
            if sel then
                item.qty = item.qty + 1
                RenderItems(scrollFrame, refreshFn)
                if refreshFn then refreshFn() end
            end
        end)
    end

    scrollFrame.CanvasSize = UDim2.new(0, 0, 0, math.max(#Inventory * 51 + 10, 120))
end

