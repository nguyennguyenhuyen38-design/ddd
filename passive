-- ===================== INVENTORY SYSTEM (Dynamic from hidden module) =====================

local function DetectInventoryModules()
    local candidates = {}

    local function search(parent, path)
        if not parent then return end
        pcall(function()
            for _, child in pairs(parent:GetChildren()) do
                local childPath = path .. "." .. child.Name
                if child:IsA("ModuleScript") then
                    local ok, env = pcall(require, child)
                    if ok and env then
                        if env.Items or env.Inventory or env.GetInventory or env.ItemsDB or env.ItemData then
                            table.insert(candidates, {module = child, path = childPath, env = env})
                        end
                    end
                end
                if child:IsA("Folder") or child:IsA("ModuleScript") or child:IsA("RemoteEvent") then
                    search(child, childPath)
                end
            end
        end)
    end

    pcall(function() search(ReplicatedStorage, "ReplicatedStorage") end)
    pcall(function() search(game:GetService("ServerScriptService"), "ServerScriptService") end)
    pcall(function() search(game:GetService("StarterGui"), "StarterGui") end)
    pcall(function() search(game:GetService("StarterPlayer"):WaitForChild("StarterPlayerScripts"), "StarterPlayerScripts") end)

    pcall(function()
        for _, remote in pairs(ReplicatedStorage:GetChildren()) do
            if remote:IsA("RemoteEvent") or remote:IsA("RemoteFunction") then
                local name = remote.Name:lower()
                if name:find("inventory") or name:find("item") or name:find("backpack") then
                    Log("Tim thay remote inventory: " .. remote.Name, Color3.fromRGB(200, 200, 100))
                end
            end
        end
    end)

    return candidates
end

local function BuildItemDatabaseFromModules()
    local modules = DetectInventoryModules()

    for _, cand in ipairs(modules) do
        pcall(function()
            local env = cand.env
            local items = env.Items or env.ItemData or env.ItemsDB

            if items then
                for name, data in pairs(items) do
                    if type(data) == "table" then
                        ItemDatabase[tostring(name)] = {
                            tier = data.tier or 1,
                            value = data.value or data.price or data.cost or 100,
                            rarity = data.rarity or data.rare or data.tier or "Common",
                            source = cand.path
                        }
                    elseif type(data) == "number" then
                        ItemDatabase[tostring(name)] = {tier = 1, value = data, rarity = "Common", source = cand.path}
                    end
                end
                Log("Load item database tu: " .. cand.path, Color3.fromRGB(100, 255, 100))
            end
        end)
    end

    return #modules > 0
end

local function ScanHiddenInventory()
    local inventoryItems = {}

    pcall(function()
        local searchPaths = {
            LocalPlayer:FindFirstChild("Inventory"),
            LocalPlayer:FindFirstChild("Backpack"),
            LocalPlayer:FindFirstChild("Data"),
            LocalPlayer:FindFirstChild("Profile"),
            LocalPlayer:FindFirstChild("PlayerData"),
            LocalPlayer:FindFirstChild("Items"),
            LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Inventory"),
        }

        for _, path in ipairs(searchPaths) do
            if path then
                scanInventoryFolder(path, inventoryItems)
            end
        end

        for _, gui in pairs(LocalPlayer.PlayerGui:GetChildren()) do
            if gui:IsA("ScreenGui") then
                local invName = gui.Name:lower()
                if invName:find("inventory") or invName:find("backpack") or invName:find("item") or invName:find("bag") then
                    scanInventoryGui(gui, inventoryItems)
                end
            end
        end
    end)

    return inventoryItems
end

local function scanInventoryFolder(folder, result)
    if not folder then return end
    pcall(function()
        for _, item in pairs(folder:GetChildren()) do
            if item:IsA("Folder") then
                local itemName = item.Name
                local itemData = extractItemData(item)
                if itemName and #itemName > 0 then
                    result[itemName] = itemData
                end
                scanInventoryFolder(item, result)
            elseif item:IsA("ModuleScript") then
                local ok, env = pcall(require, item)
                if ok and env then
                    if env.Items then
                        for name, data in pairs(env.Items) do
                            result[tostring(name)] = extractItemDataFromTable(data)
                        end
                    end
                end
            else
                local itemName = item.Name
                if itemName and #itemName > 1 and not itemName:match("^[%s%d]+$") then
                    result[itemName] = extractItemData(item)
                end
            end
        end
    end)
end

local function scanInventoryGui(gui, result)
    pcall(function()
        for _, obj in pairs(gui:GetDescendants()) do
            local itemName = nil
            local itemData = {}

            if obj:IsA("TextLabel") or obj:IsA("TextButton") then
                local txt = obj.Text
                if txt and #txt > 1 and not txt:match("^[%s%d%:,]+$") then
                    local clean = txt:gsub("[^%w%s%-_]", ""):gsub("%s+", " "):match("^%s*(.-)%s*$")
                    if #clean > 1 then
                        itemName = clean
                    end
                end
            elseif obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
                if obj.Name and #obj.Name > 1 and not obj.Name:match("^[%s%d]+$") then
                    itemName = obj.Name
                end
            end

            if itemName and #itemName > 1 then
                pcall(function()
                    for _, sibling in pairs(obj.Parent and obj.Parent:GetChildren() or {}) do
                        if sibling:IsA("TextLabel") then
                            local siblingTxt = sibling.Text
                            if siblingTxt and siblingTxt:match("%d+") then
                                itemData.value = tonumber(siblingTxt:match("%d+")) or 0
                            end
                            if siblingTxt:lower():find("rare") then itemData.rarity = "Rare" end
                            if siblingTxt:lower():find("epic") then itemData.rarity = "Epic" end
                            if siblingTxt:lower():find("legend") then itemData.rarity = "Legendary" end
                            if siblingTxt:lower():find("common") then itemData.rarity = "Common" end
                        end
                    end
                end)
                result[itemName] = extractItemDataFromTable(itemData)
            end
        end
    end)
end

local function extractItemData(item)
    local data = {}
    pcall(function()
        for _, prop in pairs({"Value", "Tier", "Rarity", "Price", "Cost", "Amount", "Count"}) do
            local child = item:FindFirstChild(prop)
            if child then
                if prop == "Tier" or prop == "Value" or prop == "Price" or prop == "Cost" then
                    data.value = tonumber(child.Value) or data.value
                end
                if prop == "Rarity" or prop == "Tier" then
                    data.rarity = tostring(child.Value) or data.rarity
                end
            end
        end
    end)
    return data
end

local function extractItemDataFromTable(t)
    if not t then return {} end
    return {
        tier = t.tier or t.Tier or 1,
        value = t.value or t.Value or t.price or t.Price or t.cost or t.Cost or 100,
        rarity = t.rarity or t.Rarity or t.rare or t.Rare or "Common",
    }
end

local function GetItemValue(itemName)
    local dbItem = ItemDatabase[itemName]
    if dbItem then
        return dbItem.value, dbItem.rarity, dbItem.tier
    end

    local invItem = PlayerInventoryCache[itemName]
    if invItem then
        return invItem.value or 100, invItem.rarity or "Unknown", invItem.tier or 1
    end

    local rarity = "Unknown"
    local tier = 1
    local nameLower = itemName:lower()

    if nameLower:find("legend") or nameLower:find("mythic") or nameLower:find("ancient") then
        rarity = "Legendary"; tier = 5
    elseif nameLower:find("epic") then
        rarity = "Epic"; tier = 4
    elseif nameLower:find("rare") or nameLower:find("unique") then
        rarity = "Rare"; tier = 3
    elseif nameLower:find("uncommon") or nameLower:find("uncom") then
        rarity = "Uncommon"; tier = 2
    elseif nameLower:find("common") or nameLower:find("basic") then
        rarity = "Common"; tier = 1
    end

    local value = 100
    if nameLower:find("gold") or nameLower:find("coin") then value = math.max(value, 50) end
    if nameLower:find("dragon") or nameLower:find("phoenix") then value = math.max(value, 5000) end
    if nameLower:find("king") or nameLower:find("queen") or nameLower:find("emperor") then value = math.max(value, 10000) end
    if nameLower:find("god") or nameLower:find("divine") then value = math.max(value, 50000) end

    return value, rarity, tier
end

