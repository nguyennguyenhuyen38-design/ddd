-- Tim remote de gui trade request
local function GetTradeRemote()
    for _, obj in pairs(ReplicatedStorage:GetChildren()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            if string.lower(obj.Name):find("trade") and not string.lower(obj.Name):find("accept") then
                return obj
            end
        end
    end

    local function findInChild(parent)
        for _, obj in pairs(parent:GetChildren()) do
            if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
                if string.lower(obj.Name):find("trade") and not string.lower(obj.Name):find("accept") then
                    return obj
                end
            end
            local found = findInChild(obj)
            if found then return found end
        end
    end

    return findInChild(ReplicatedStorage)
end

-- Gui trade request den player
local function SendTradeRequest(targetPlayer)
    if not targetPlayer then
        Log("Loi: Khong co player duoc chon", Color3.fromRGB(255, 80, 80))
        return false
    end

    if targetPlayer == LocalPlayer then
        Log("Loi: Khong the trade voi chinh minh", Color3.fromRGB(255, 80, 80))
        return false
    end

    TradeSession.targetPlayer = targetPlayer
    TradeSession.targetUsername = targetPlayer.Name
    TradeSession.itemsToTrade = {}
    TradeSession.active = true

    -- Gui remote trade request
    local tradeRemote = GetTradeRemote()
    if tradeRemote then
        pcall(function()
            if tradeRemote:IsA("RemoteFunction") then
                tradeRemote:CallServerAsync(targetPlayer)
            else
                tradeRemote:FireServer(targetPlayer)
            end
        end)
        Log("Da gui trade request den: " .. targetPlayer.Name, Color3.fromRGB(85, 255, 85))
    else
        -- Thu cach khac - mo trade GUI bang cach tim button
        pcall(function()
            for _, gui in pairs(LocalPlayer.PlayerGui:GetChildren()) do
                if gui:IsA("ScreenGui") then
                    for _, btn in pairs(gui:GetDescendants()) do
                        if btn:IsA("TextButton") or btn:IsA("ImageButton") then
                            local txt = string.lower(btn.Text or "")
                            local name = string.lower(btn.Name or "")
                            if txt:find("trade") and not txt:find("cancel") and not txt:find("close") then
                                pcall(function() firesignal(btn.MouseButton1Click) end)
                            end
                        end
                    end
                end
            end
        end)
        Log("Da gui trade request den: " .. targetPlayer.Name, Color3.fromRGB(85, 255, 85))
    end

    SessionStats.trades_sent = SessionStats.trades_sent + 1
    return true
end

