                            local val, rarity, tier = GetItemValue(name)
                            table.insert(lines, string.format("%d. %s [%s]", i, name, rarity))
                        end
                        if #inventory > maxShow then
                            table.insert(lines, string.format("... va %d items khac", #inventory - maxShow))
                        end
