-- ===================== INVENTORY SCANNER (PRECISE) =====================
local function ScanInventory()
    Inventory = {}
    Log("Bat dau quet inventory...")

    local panel = FindInventoryPanel()
    if not panel then
        Log("Khong tim thay InventoryPanelClient")
        return Inventory
    end

    local mainFrame = panel:FindFirstChild("MainFrame")
    if not mainFrame then
        Log("Khong tim thay MainFrame trong InventoryPanel")
        return Inventory
    end

    local content = mainFrame:FindFirstChild("Content")
    if not content then
        Log("Khong tim thay Content trong MainFrame")
        return Inventory
    end

    local storageHolder = content:FindFirstChild("StorageHolder")
    if not storageHolder then
        Log("Khong tim thay StorageHolder")
        return Inventory
    end

    local storage = storageHolder:FindFirstChild("Storage")
    if not storage then
        storage = storageHolder
    end

    local slotsScanned = 0

    for _, slot in pairs(storage:GetChildren()) do
        if slot:IsA("Frame") or slot:IsA("TextButton") then
            local slotName = slot.Name
            if slotName:match("Slot") or slotName:match("slot") then
                local itemNameObj = slot:FindFirstChild("ItemName") or slot:FindFirstChild("ItemName")
                local qtyObj = slot:FindFirstChild("Quantity") or slot:FindFirstChild("Amount") or slot:FindFirstChild("ItemAmount")

                local itemName = nil
                local qty = 1

                if itemNameObj and itemNameObj:IsA("TextLabel") then
                    itemName = itemNameObj.Text
                end

                if qtyObj and qtyObj:IsA("TextLabel") then
                    local qtyStr = qtyObj.Text
                    qty = tonumber(qtyStr) or 1
                end

                if itemName and #itemName > 0 and not itemName:match("^%s*$") then
                    itemName = itemName:gsub("^%s+", ""):gsub("%s+$", "")

                    local cleanName = itemName:gsub("[^%w%s%-_'.]", ""):match("^%s*(.-)%s*$")

                    if #cleanName > 1 then
                        local data = ITEM_DATABASE[cleanName]

                        if not data then
                            for dbName, dbData in pairs(ITEM_DATABASE) do
                                local lowerDb = string.lower(dbName)
                                local lowerClean = string.lower(cleanName)
                                if lowerClean:find(lowerDb, 1, true) or lowerDb:find(lowerClean, 1, true) then
                                    data = dbData
                                    cleanName = dbName
                                    break
                                end
                            end
                        end

                        if data then
                            local exists = false
                            for _, inv in ipairs(Inventory) do
                                if string.lower(inv.name) == string.lower(cleanName) then
                                    inv.qty = inv.qty + qty
                                    exists = true
                                    break
                                end
                            end

                            if not exists then
                                table.insert(Inventory, {
                                    name = cleanName,
                                    rarity = data.rarity,
                                    tier = data.tier,
                                    value = data.value,
                                    qty = qty,
                                    selected = false,
                                    slotRef = slot
                                })
                            end
                        end
                    end
                end
                slotsScanned = slotsScanned + 1
            end
        end
    end

    table.sort(Inventory, function(a, b)
        if a.tier ~= b.tier then return a.tier > b.tier end
        return a.name < b.name
    end)

    Log("Quet xong - " .. #Inventory .. " items (" .. slotsScanned .. " slots)")
    return Inventory
end

-- ===================== TRADE FLOW =====================
local function FindTradeRemote()
    for _, obj in pairs(ReplicatedStorage:GetChildren()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            local n = string.lower(obj.Name)
            if n:find("trade") and not n:find("accept") and not n:find("cancel") and not n:find("request") then
                return obj
            end
        end
    end
    return nil
end

local function FindTradeRequestRemote()
    for _, obj in pairs(ReplicatedStorage:GetChildren()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            local n = string.lower(obj.Name)
            if n:find("trade") and n:find("request") then
                return obj
            end
        end
    end
    return nil
end

local function SendTradeRequest(player)
    if not player then
        Log("Loi: chua chon player")
        return false
    end

    Log("Dang gui trade toi: " .. player.Name)

    local remote = FindTradeRemote()
    if not remote then
        remote = FindTradeRequestRemote()
    end

    if remote then
        Log("Tim thay remote: " .. remote.Name)
        pcall(function()
            if remote:IsA("RemoteFunction") then
                remote:CallServerAsync(player)
            else
                remote:FireServer(player)
            end
        end)
        Log("Da goi remote trade")
        return true
    else
        Log("Khong tim thay trade remote")
        return false
    end
end

