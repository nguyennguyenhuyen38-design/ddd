-- ===================== HELPERS =====================
local function Corner(parent, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r or 8)
    c.Parent = parent
    return c
end

local function Stroke(parent, color, thick)
    local s = Instance.new("UIStroke")
    s.Color = color or C.bg3
    s.Thickness = thick or 1
    s.Parent = parent
    return s
end

local function Txt(parent, props)
    local t = Instance.new("TextLabel")
    for k, v in pairs(props) do
        t[k] = v
    end
    t.Parent = parent
    return t
end

local function Btn(parent, props)
    local b = Instance.new("TextButton")
    for k, v in pairs(props) do
        b[k] = v
    end
    b.AutoButtonColor = false
    Corner(b, 8)
    b.Parent = parent
    return b
end

local function Frame(parent, props)
    local f = Instance.new("Frame")
    for k, v in pairs(props) do
        f[k] = v
    end
    f.Parent = parent
    return f
end

local function SetText(obj, txt)
    if obj and obj.Parent then
        pcall(function()
            if obj:IsA("TextLabel") or obj:IsA("TextButton") then
                obj.Text = txt
            end
        end)
    end
end

local function SetColor(obj, col)
    if obj and obj.Parent then
        pcall(function()
            if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("Frame") then
                obj.BackgroundColor3 = col
            end
        end)
    end
end

local function FormatVal(v)
    if not v then return "0" end
    if v >= 1000000 then return string.format("%.1fM", v / 1000000)
    elseif v >= 1000 then return string.format("%.1fK", v / 1000)
    else return tostring(v) end
end

local function GetRarityColor(rarity)
    rarity = string.lower(rarity or "")
    if rarity == "legendary" then return C.rarLegend
    elseif rarity == "epic" then return C.rarEpic
    elseif rarity == "rare" then return C.rarRare
    elseif rarity == "uncommon" then return C.rarUncom
    else return C.rarCommon end
end

local function Click(obj)
    if not obj then return end
    pcall(function()
        local events = obj:GetChildren()
        for _, e in ipairs(events) do
            if e:IsA("RemoteEvent") then
                e:FireServer()
                return
            end
        end
        local input = Enum.UserInputType.BeginTouch
        if obj:IsA("TextButton") then
            obj:InputBegin(input)
            obj:InputEnd(input)
        end
    end)
end

-- ===================== DRAG SYSTEM =====================
local function MakeDraggable(frame)
    local dragging = false
    local dragInput
    local startPos
    local startInput

    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            startPos = frame.Position
            startInput = input.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    frame.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input == dragInput) then
            local delta = input.Position - startInput
            frame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
end

