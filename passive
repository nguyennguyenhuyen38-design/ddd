-- Wrapper cho FindFirstChild để tương thích với JJSPoit
-- (JJSPoit KHÔNG hỗ trợ tham số thứ 2 trong FindFirstChild)
pcall(function()
    local OrigFindFirstChild = workspace.FindFirstChild
    workspace.FindFirstChild = function(self, name, timeout)
        if timeout then
            -- JJSPoit: FindFirstChild không có timeout, tự động chờ
            local startTime = tick()
            local child
            repeat
                child = OrigFindFirstChild(self, name)
                if child then break end
                wait(0.1)
            until (tick() - startTime) >= (timeout or 1)
            return child
        end
        return OrigFindFirstChild(self, name)
    end
end)

-- Tạo alias để code gốc hoạt động mà không cần sửa nhiều
local function safeWait(seconds)
    seconds = seconds or 0.016
    if seconds < 0.016 then
        wait()
    else
        local total = seconds
        local current = 0
        while current < total do
            local step = math.min(0.1, total - current)
            wait(step)
            current = current + step
        end
    end
end

-- Wrapper cho task library (JJSPoit hỗ trợ task.wait)
local task = task or {}
if not task.wait then task.wait = safeWait end
if not task.delay then
    task.delay = function(delayTime, callback, ...)
        local args = {...}
        spawn(function()
            wait(delayTime or 0)
            callback(unpack(args))
        end)
    end
end
if not task.spawn then task.spawn = spawn end

