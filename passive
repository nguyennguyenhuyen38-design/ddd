-- ===================== INVENTORY SCANNER =====================
local function ScanInventory()
    Inventory = {}
    Log("Bat dau quet inventory...")

    -- Quet tat ca GUI trong PlayerGui
    local foundNames = {}

    local function ScanGui(gui, depth)
        if depth > 5 then return end
        pcall(function()
            for _, child in pairs(gui:GetChildren()) do
                pcall(function()
                    -- Lay text tu TextLabel
                    if child:IsA("TextLabel") or child:IsA("TextButton") then
                        local txt = child.Text
                        if txt and type(txt) == "string" and #txt > 0 then
                            local clean = txt:gsub("[^%w%s%-_'.]", ""):gsub("%s+", " "):match("^%s*(.-)%s*$")
                            if #clean > 1 and #clean < 60 and not clean:match("^[%d%s%,%.%:]+$") and not clean:match("^rbx") then
                                foundNames[string.lower(clean)] = clean
                            end
                        end
                    end

                    -- Lay text tu ImageLabel (dung name)
                    if child:IsA("ImageLabel") or child:IsA("ImageButton") then
                        local nm = child.Name
                        if nm and type(nm) == "string" and #nm > 1 and #nm < 60 and not nm:match("^[%s%d]+$") and not nm:match("^rbx") and not nm:match("^Icon") and not nm:match("^Image") then
                            foundNames[string.lower(nm)] = nm
                        end
                    end

                    ScanGui(child, depth + 1)
                end)
            end
        end)
    end

    -- Scan PlayerGui
    for _, gui in pairs(LocalPlayer.PlayerGui:GetChildren()) do
        if gui:IsA("ScreenGui") then
            pcall(function() ScanGui(gui, 0) end)
        end
    end

    -- Scan Character
    if LocalPlayer.Character then
        pcall(function() ScanGui(LocalPlayer.Character, 0) end)
    end

    -- Map voi ITEM_DATABASE
    for lowerName, originalName in pairs(foundNames) do
        -- Exact match
        if ITEM_DATABASE[originalName] then
            local data = ITEM_DATABASE[originalName]
            table.insert(Inventory, {
                name = originalName,
                rarity = data.rarity,
                tier = data.tier,
                value = data.value,
                qty = 1,
                selected = false
            })
        else
            -- Partial match
            for dbName, data in pairs(ITEM_DATABASE) do
                local lowerDb = string.lower(dbName)
                if lowerName:find(lowerDb, 1, true) or lowerDb:find(lowerName, 1, true) then
                    -- Trung khop
                    local exists = false
                    for _, inv in ipairs(Inventory) do
                        if string.lower(inv.name) == lowerDb then
                            exists = true
                            break
                        end
                    end
                    if not exists then
                        table.insert(Inventory, {
                            name = dbName,
                            rarity = data.rarity,
                            tier = data.tier,
                            value = data.value,
                            qty = 1,
                            selected = false
                        })
                    end
                    break
                end
            end
        end
    end

    -- Sort
    table.sort(Inventory, function(a, b)
        if a.tier ~= b.tier then return a.tier > b.tier end
        return a.name < b.name
    end)

    Log("Quet xong - " .. #Inventory .. " items trong database")
    return Inventory
end

-- ===================== TRADE =====================
local function SendTradeRequest(player)
    if not player then
        Log("Loi: chua chon player")
        return
    end

    Log("Dang gui trade toi: " .. player.Name)

    local remote = nil
    for _, obj in pairs(ReplicatedStorage:GetChildren()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            local n = string.lower(obj.Name)
            if n:find("trade") and not n:find("accept") and not n:find("cancel") then
                remote = obj
                Log("Tim thay remote: " .. obj.Name)
                break
            end
        end
    end

    if remote then
        pcall(function()
            if remote:IsA("RemoteFunction") then
                remote:CallServerAsync(player)
            else
                remote:FireServer(player)
            end
        end)
        Log("Da goi remote trade")
    else
        Log("Khong tim thay trade remote trong ReplicatedStorage")
    end
end

-- ===================== RENDER ITEMS =====================
local function RenderItems(scrollFrame, onSummaryUpdate)
    -- Xoa child cu
    for _, c in pairs(scrollFrame:GetChildren()) do
        if c:IsA("Frame") then
            pcall(function() c:Destroy() end)
        end
    end

    local ly = Instance.new("UIListLayout")
    ly.SortOrder = Enum.SortOrder.LayoutOrder
    ly.Padding = UDim.new(0, 3)
    ly.Parent = scrollFrame

    if #Inventory == 0 then
        local e = Txt(scrollFrame, {
            Size = UDim2.new(1, 0, 0, 100),
            BackgroundTransparency = 1,
            Text = "Chua co item nao.\n\nNhan [QUET] de quet inventory.",
            TextColor3 = C.dim,
            TextSize = 12,
            Font = Enum.Font.Gotham,
            TextYAlignment = Enum.TextYAlignment.Center,
            LayoutOrder = 0
        })
        scrollFrame.CanvasSize = UDim2.new(0, 0, 0, 100)
        return
    end

    for i, item in ipairs(Inventory) do
        local sel = item.selected
        local rCol = GetRarityColor(item.rarity)

        local row = Frame(scrollFrame, {
            Size = UDim2.new(1, 0, 0, 52),
            BackgroundColor3 = sel and Color3.fromRGB(25, 50, 30) or ((i % 2 == 0) and C.bg3 or C.bg2),
            BorderSizePixel = 0,
            LayoutOrder = i
        })
        Corner(row, 6)
        if sel then
            Stroke(row, C.green, 1)
        end

        -- Checkbox
        local cb = Btn(row, {
            Size = UDim2.new(0, 34, 0, 34),
            Position = UDim2.new(0, 6, 0.5, -17),
            BackgroundColor3 = sel and Color3.fromRGB(50, 150, 50) or C.bg3,
            Text = sel and "Y" or "",
            TextColor3 = Color3.fromRGB(255, 255, 255),
            TextSize = 16,
            Font = Enum.Font.GothamBold
        })
        Corner(cb, 6)
        cb.MouseButton1Click:Connect(function()
            item.selected = not item.selected
            if item.selected then item.qty = 1 end
            RenderItems(scrollFrame, onSummaryUpdate)
            if onSummaryUpdate then onSummaryUpdate() end
        end)

        -- Name
        Txt(row, {
            Size = UDim2.new(1, -145, 0, 18),
            Position = UDim2.new(0, 46, 0, 6),
            BackgroundTransparency = 1,
            Text = item.name,
            TextColor3 = sel and Color3.fromRGB(255, 255, 255) or rCol,
            TextSize = 12,
            Font = Enum.Font.GothamBold,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd
        })

        -- Rarity + Value
        Txt(row, {
            Size = UDim2.new(1, -145, 0, 14),
            Position = UDim2.new(0, 46, 0, 26),
            BackgroundTransparency = 1,
            Text = item.rarity .. " | " .. FormatVal(item.value),
            TextColor3 = C.dim,
            TextSize = 9,
            Font = Enum.Font.Gotham,
            TextXAlignment = Enum.TextXAlignment.Left
        })

        -- Qty +/-
        local qf = Frame(row, {
            Size = UDim2.new(0, 88, 0, 30),
            Position = UDim2.new(1, -94, 0.5, -15),
            BackgroundTransparency = 1
        })

        local function mkBtn(txt, onClick)
            local b = Btn(qf, {
                Size = UDim2.new(0, 26, 0, 26),
                BackgroundColor3 = C.bg3,
                Text = txt,
                TextColor3 = sel and C.text or C.dim,
                TextSize = 15,
                Font = Enum.Font.GothamBold
            })
            Corner(b, 5)
            b.MouseButton1Click:Connect(onClick)
            return b
        end

        mkBtn("-", function()
            if sel and item.qty > 1 then
                item.qty = item.qty - 1
                RenderItems(scrollFrame, onSummaryUpdate)
                if onSummaryUpdate then onSummaryUpdate() end
            end
        end)

        local ql = Txt(qf, {
            Size = UDim2.new(0, 36, 0, 26),
            Position = UDim2.new(0, 26, 0, 0),
            BackgroundColor3 = C.bg3,
            Text = "x" .. item.qty,
            TextColor3 = sel and C.accent or C.dim,
            TextSize = 11,
            Font = Enum.Font.GothamBold
        })
        Corner(ql, 5)

        mkBtn("+", function()
            if sel then
                item.qty = item.qty + 1
                RenderItems(scrollFrame, onSummaryUpdate)
                if onSummaryUpdate then onSummaryUpdate() end
            end
        end)
    end

    scrollFrame.CanvasSize = UDim2.new(0, 0, 0, math.max(#Inventory * 55 + 10, 120))
end

