-- ===================== UTILS =====================
local function SetText(obj, txt)
    if obj and obj.Parent then
        pcall(function() obj.Text = txt end)
    end
end

local function RarityColor(r)
    r = string.lower(r or "")
    if r:find("legend") or r:find("mythic") then return Color3.fromRGB(255, 180, 0)
    elseif r:find("epic") then return Color3.fromRGB(180, 80, 255)
    elseif r:find("rare") then return Color3.fromRGB(80, 160, 255)
    elseif r:find("uncommon") then return Color3.fromRGB(80, 200, 80)
    else return Color3.fromRGB(160, 160, 180) end
end

local function RarityFromName(name)
    local n = string.lower(name)
    if n:find("legend") or n:find("mythic") then return "Legendary", 5
    elseif n:find("epic") then return "Epic", 4
    elseif n:find("rare") then return "Rare", 3
    elseif n:find("uncommon") then return "Uncommon", 2
    else return "Common", 1 end
end

local function ValueFromName(name)
    local n = string.lower(name)
    if n:find("legend") or n:find("mythic") then return 10000
    elseif n:find("epic") then return 5000
    elseif n:find("rare") then return 1000
    elseif n:find("uncommon") then return 500
    else return 100 end
end

local function FormatVal(v)
    if not v then return "0" end
    if v >= 1000000 then return string.format("%.1fM", v / 1000000)
    elseif v >= 1000 then return string.format("%.1fK", v / 1000)
    else return tostring(v) end
end

