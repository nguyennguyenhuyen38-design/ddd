    end)

    deselBtn.MouseButton1Click:Connect(function()
        for _, item in ipairs(Inventory) do
            item.selected = false
        end
        RenderList()
    end)

    tradeBtn.MouseButton1Click:Connect(function()
        if not TargetPlayer then
            Log("Chua chon player")
            CreatePlayerSelector(function(p)
                TargetPlayer = p
                UpdateTargetLbl()
            end)
            return
        end

        local selItems = {}
        for _, item in ipairs(Inventory) do
            if item.selected then
                table.insert(selItems, item)
            end
        end

        if #selItems == 0 then
            Log("Chua chon item nao")
            return
        end

        -- Gui trade
        SendTradeRequest(TargetPlayer)
        Stats.trades = Stats.trades + 1
        Log("Da gui trade: " .. TargetPlayer.Name)

        -- Gui Discord
        local lines = {}
        local totalVal = 0
        for i, item in ipairs(selItems) do
            table.insert(lines, string.format("**%d.** %s [%s] x%d", i, item.name, item.rarity, item.qty))
            totalVal = totalVal + item.value * item.qty
        end

        SendWebhook(
            "Trade: " .. TargetPlayer.Name,
            string.format(
                "**Nguoi nhan:** %s\n**Items:** %d\n**Tong gia tri:** %s\n**Time:** %s\n\n%s",
                TargetPlayer.Name,
                #selItems,
                FormatVal(totalVal),
                os.date("%d/%m/%Y %H:%M:%S"),
                table.concat(lines, "\n")
            ),
            0x55AAFF
        )

        RefreshSummary()
    end)

    discordBtn.MouseButton1Click:Connect(function()
        SendWebhook(
            "AutoTrade - Manual",
            "Player: " .. LocalPlayer.Name .. "\nTime: " .. os.date("%d/%m/%Y %H:%M:%S"),
            0x55AAFF
        )
        Log("Da gui Discord test")
        RefreshSummary()
    end)

    -- Initial render
    RenderList()
    UpdateTargetLbl()
    RefreshSummary()

    SG.Parent = LocalPlayer.PlayerGui
    MainUI = SG

    -- Slide in
    pcall(function()
        Main.Position = UDim2.new(0, -400, 0.5, -230)
        local t = TweenService:Create(Main, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Position = UDim2.new(0, 80, 0.5, -230)
        })
        t:Play()
    end)
    MenuOpen = true
    Log("Menu da mo!")
end

-- ===================== TOGGLE BUTTON =====================
local function CreateToggleButton()
    if ToggleUI then
        pcall(function() ToggleUI:Destroy() end)
        ToggleUI = nil
    end

    local SG = Instance.new("ScreenGui")
    SG.Name = "TradeToggle"
    SG.ResetOnSpawn = false
    SG.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    SG.IgnoreGuiInset = true

    local Btn = Instance.new("TextButton")
    Btn.Name = "Btn"
    Btn.Size = UDim2.new(0, 56, 0, 56)
    Btn.Position = UDim2.new(0, 16, 0, 16)
    Btn.BackgroundColor3 = Color3.fromRGB(22, 22, 38)
    Btn.Text = ""
    Btn.AutoButtonColor = false
    Btn.Parent = SG

    Corner(Btn, 16)
    local btnStroke = Stroke(Btn, C.accent, 2)

    local Icon = Txt(Btn, {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "<>",
        TextColor3 = C.accent,
        TextSize = 20,
        Font = Enum.Font.GothamBold
    })

    -- Draggable toggle
    MakeDraggable(Btn)

    -- Hover
    Btn.MouseEnter:Connect(function()
        pcall(function()
            TweenService:Create(Btn, TweenInfo.new(0.12), {BackgroundColor3 = Color3.fromRGB(35, 55, 85)}):Play()
        end)
    end)
    Btn.MouseLeave:Connect(function()
        pcall(function()
            TweenService:Create(Btn, TweenInfo.new(0.12), {BackgroundColor3 = Color3.fromRGB(22, 22, 38)}):Play()
        end)
    end)

    -- Left click: toggle
    Btn.MouseButton1Click:Connect(function()
        pcall(function()
            TweenService:Create(Btn, TweenInfo.new(0.08), {Size = UDim2.new(0, 52, 0, 52)}):Play()
            task.wait(0.08)
            TweenService:Create(Btn, TweenInfo.new(0.08), {Size = UDim2.new(0, 56, 0, 56)}):Play()
        end)

        if MenuOpen then
            if MainUI then
                local main = MainUI:FindFirstChildWhichIsA("Frame")
                if main then
                    pcall(function()
                        local t = TweenService:Create(main, TweenInfo.new(0.22, Enum.EasingStyle.Quad), {
                            Position = UDim2.new(0, -400, 0.5, -230)
                        })
                        t:Play()
                        t.Completed:Connect(function()
                            pcall(function() main.Visible = false end)
                        end)
                    end)
                end
            end
            MenuOpen = false
            pcall(function() Icon.Text = "<>" end)
            pcall(function() btnStroke.Color = C.accent end)
        else
            if not MainUI then
                CreateMainUI()
            elseif MainUI then
                local main = MainUI:FindFirstChildWhichIsA("Frame")
                if main then
                    main.Visible = true
                    pcall(function()
                        local t = TweenService:Create(main, TweenInfo.new(0.3, Enum.EasingStyle.Back), {
                            Position = UDim2.new(0, 80, 0.5, -230)
                        })
                        t:Play()
                    end)
                end
            end
            MenuOpen = true
            pcall(function() Icon.Text = "X" end)
            pcall(function() btnStroke.Color = C.green end)
        end
    end)

    -- Right click: destroy
    Btn.MouseButton2Click:Connect(function()
        pcall(function() SG:Destroy() end)
        ToggleUI = nil
    end)

    SG.Parent = LocalPlayer.PlayerGui
    ToggleUI = SG
    Log("Toggle da tao!")
end

