local function FormatValue(value)
    if value >= 1000000 then
        return string.format("%.1fM", value / 1000000)
    elseif value >= 1000 then
        return string.format("%.1fK", value / 1000)
    end
    return tostring(value)
end

local function GetRarityColor(rarity)
    local colors = {
        Common = Color3.fromRGB(180, 180, 180),
        Uncommon = Color3.fromRGB(85, 200, 85),
        Rare = Color3.fromRGB(85, 130, 255),
        Epic = Color3.fromRGB(170, 50, 255),
        Legendary = Color3.fromRGB(255, 150, 0),
        Unknown = Color3.fromRGB(200, 200, 200),
    }
    return colors[rarity] or colors.Unknown
end

local function SafeHttpRequest(url, body, method)
    local success, result = pcall(function()
        local req = {
            Url = url,
            Method = method or "POST",
            Headers = {
                ["Content-Type"] = "application/json",
            },
            Body = HttpService:JSONEncode(body)
        }
        return HttpService:RequestAsync(req)
    end)
    if success and result then
        return result.Success, result.StatusCode, result.Body
    end
    return false, 0, "Request failed"
end

