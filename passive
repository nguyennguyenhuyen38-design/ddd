-- ===================== TOGGLE BUTTON =====================
local function CreateToggleButton()
    if ToggleUI then pcall(function() ToggleUI:Destroy() end); ToggleUI = nil end

    local SG = Instance.new("ScreenGui")
    SG.Name = "TradeToggle"
    SG.ResetOnSpawn = false
    SG.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    SG.IgnoreGuiInset = true

    local Btn = Instance.new("TextButton")
    Btn.Name = "Btn"
    Btn.Size = UDim2.new(0, 56, 0, 56)
    Btn.Position = UDim2.new(0, 16, 0, 16)
    Btn.BackgroundColor3 = Color3.fromRGB(22, 22, 38)
    Btn.Text = ""
    Btn.AutoButtonColor = false
    Btn.Draggable = true
    Btn.Parent = SG

    Corner(Btn, 16)
    Stroke(Btn, C.accent, 2)

    local Icon = Txt(Btn, {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "<>",
        TextColor3 = C.accent,
        TextSize = 20,
        Font = Enum.Font.GothamBold
    })

    -- Hover
    Btn.MouseEnter:Connect(function()
        pcall(function()
            TweenService:Create(Btn, TweenInfo.new(0.12), {BackgroundColor3 = Color3.fromRGB(35, 55, 85)}):Play()
        end)
    end)
    Btn.MouseLeave:Connect(function()
        pcall(function()
            TweenService:Create(Btn, TweenInfo.new(0.12), {BackgroundColor3 = Color3.fromRGB(22, 22, 38)}):Play()
        end)
    end)

    -- Click
    Btn.MouseButton1Click:Connect(function()
        pcall(function()
            TweenService:Create(Btn, TweenInfo.new(0.08), {Size = UDim2.new(0, 52, 0, 52)}):Play()
            task.wait(0.08)
            TweenService:Create(Btn, TweenInfo.new(0.08), {Size = UDim2.new(0, 56, 0, 56)}):Play()
        end)

        if MenuOpen then
            -- An menu
            if MainUI then
                local main = MainUI:FindFirstChildWhichIsA("Frame")
                if main then
                    pcall(function()
                        local t = TweenService:Create(main, TweenInfo.new(0.22, Enum.EasingStyle.Quad), {
                            Position = UDim2.new(0, -400, 0.5, -220)
                        })
                        t:Play()
                        t.Completed:Connect(function() pcall(function() main.Visible = false end) end)
                    end)
                end
            end
            MenuOpen = false
            Icon.Text = "<>"
            Stroke(Btn, C.accent, 2)
        else
            -- Mo menu
            if not MainUI then
                CreateMainUI()
            elseif MainUI then
                local main = MainUI:FindFirstChildWhichIsA("Frame")
                if main then
                    main.Visible = true
                    pcall(function()
                        local t = TweenService:Create(main, TweenInfo.new(0.3, Enum.EasingStyle.Back), {
                            Position = UDim2.new(0, 80, 0.5, -220)
                        })
                        t:Play()
                    end)
                end
            end
            MenuOpen = true
            Icon.Text = "X"
            Stroke(Btn, C.green, 2)
        end
    end)

    -- Right click: destroy
    Btn.MouseButton2Click:Connect(function()
        pcall(function() SG:Destroy() end)
        ToggleUI = nil
    end)

    SG.Parent = LocalPlayer.PlayerGui
    ToggleUI = SG
    Log("Toggle button da tao!")
end

