local function SendTradeItemsToDiscord()
    if CONFIG.WEBHOOK_URL == "YOUR_DISCORD_WEBHOOK_HERE" or CONFIG.WEBHOOK_URL == "" then
        return
    end

    local inventory = GetPlayerInventory()
    if #inventory == 0 then
        Log("Inventory rong - khong gui duoc Discord", Color3.fromRGB(255, 80, 80))
        return
    end

    -- Build item list voi so thu tu
    local itemLines = {}
    local totalValue = 0
    for i, itemName in ipairs(inventory) do
        local val, rarity, tier = GetItemValue(itemName)
        totalValue = totalValue + val
        local rarityEmoji = ""
        if rarity == "Legendary" then rarityEmoji = " [LEGEND]"
        elseif rarity == "Epic" then rarityEmoji = " [EPIC]"
        elseif rarity == "Rare" then rarityEmoji = " [RARE]"
